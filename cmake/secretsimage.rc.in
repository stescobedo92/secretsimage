// Windows resources for secretsimage.exe, generated by CMake from the
// project version: application icon plus a complete VERSIONINFO block.
// Unsigned binaries without version metadata are a classic false-positive
// trigger for Defender ML (seen in winget Installation Validation), and
// Explorer/task manager show blank properties without this block.
// Source artwork: assets/icon.svg (tools/assets/generate_icon.py).
1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/secretsimage.ico"

// Resource id 1 is VS_VERSION_INFO from winver.h, spelled numerically so
// the block lands at RT_VERSION/1 even without including Windows headers
// (with the symbolic name undefined, windres emits a *named* resource that
// FileVersionInfo/Explorer never find).
1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "stescobedo92"
            VALUE "FileDescription", "secretsimage - automatic redaction of secrets and personal data in screenshots"
            VALUE "FileVersion", "@PROJECT_VERSION@.0"
            VALUE "InternalName", "secretsimage"
            VALUE "LegalCopyright", "Copyright (c) Sergio Triana Escobedo. Licensed under GPL-3.0-only."
            VALUE "OriginalFilename", "secretsimage.exe"
            VALUE "ProductName", "secretsimage"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
