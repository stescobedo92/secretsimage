# =============================================================================
# secretsimage — C++/CMake cross-platform (Windows / Linux / macOS)
# Only sources, docs and curated assets (assets/, docs/images/) are tracked.
# Everything generated by a build, a package step or a local run stays out.
# =============================================================================

# --- Build directories -------------------------------------------------------
/build/
/build-*/
out/
dist/
install/
*.user

# --- CMake generated files ---------------------------------------------------
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
CMakeUserPresets.json
CTestTestfile.cmake
CPackConfig.cmake
CPackSourceConfig.cmake
Testing/
_deps/
compile_commands.json
.ninja_deps
.ninja_log
build.ninja
rules.ninja

# --- Compiled artifacts ------------------------------------------------------
*.obj
*.o
*.a
*.lib
*.exp
*.ilk
*.dll
*.so
*.so.*
*.dylib
*.exe
*.out
*.app
*.pdb
*.d
*.res

# --- Packaging output (published via GitHub Releases, never committed) -------
*.zip
*.tar.gz
*.tgz
*.deb
*.rpm
*.dmg
*.msi
*.sha256
!assets/*.ico
!assets/*.icns

# --- IDE and editor files ----------------------------------------------------
.vs/
.vscode/
.idea/
*.swp
*.swo
*~
.cache/
compile_commands.json

# --- OS files ----------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# --- Logs, coverage and local reports ----------------------------------------
*.log
*.gcov
*.gcda
*.gcno
coverage/
*.profraw
*.profdata

# --- Generated corpora and run output (regenerate with gen_synthetic) --------
/corpus/
*.audit.json
*.redacted.png

# --- Python helpers (asset generation scripts) -------------------------------
__pycache__/
*.pyc
.venv/
venv/

# --- Secrets must never be committed, even by accident -----------------------
*.pem
*.key
*.p12
*.pfx
.env
.env.*
!.env.example
id_rsa*
id_ed25519*
